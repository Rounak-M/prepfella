# Copy to .env (same folder) and fill in. Never commit .env.

# --- NVIDIA (build.nvidia.com → any model page → "Get API Key"; one key covers LLM, TTS and ASR)
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Nemotron model IDs. Run `python -m scripts.smoke_test` to list the ones your key can see, then pick:
#   FAST = live interview turns (question + scoring), latency matters
#   DEEP = profile review + session report, quality matters
# Candidates seen on build.nvidia.com (verify): nvidia/nemotron-3.5-super-vl-120b-a12b, nvidia/nemotron-3-ultra-550b-a55b
NIM_MODEL_FAST=
NIM_MODEL_DEEP=

# --- Speech (gRPC to NVIDIA's hosted Riva endpoints). Function IDs come from each model's
# build.nvidia.com page (API tab). Values below are from public docs; VERIFY before relying on them.
RIVA_SERVER=grpc.nvcf.nvidia.com:443
# magpie-tts-multilingual. Optional separate key for TTS only (empty = use NVIDIA_API_KEY).
TTS_API_KEY=
TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
TTS_VOICE=Magpie-Multilingual.EN-US.Aria
TTS_SAMPLE_RATE=22050
# parakeet-ctc-0.6b-asr (alternative: Nemotron ASR Streaming)
ASR_FUNCTION_ID=d8dd4e9b-fbf5-4fb0-9dba-8cf436c8d965

# --- App
# Requests/min allowed per NVIDIA API (each model and speech function separately). Free tier is ~40.
NVIDIA_RPM_LIMIT=36
# Leave empty for the default SQLite file (backend/prepfella.db). Delete that file to reset demo data.
DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
